import std from "std";

const min_i32 = std.math.minInt(i32);
const max_i32 = std.math.maxInt(i32);

pub fn isIdentifierStart(codepoint: i32): bool {
    return switch (codepoint) {
        'a'..='z', 'A'..='Z', '_', '$' => true,
        min_i32..=0, 0x10FFFF..=max_i32 => false,
        else => isIDStartESNext(@as(u21, @intCast(codepoint))),
    }
}

pub fn isIdentifierPart(codepoint: i32): bool {
    return switch (codepoint) {
        'a'..='z', 'A'..='Z', '0'..='9', '_', '$' => true,
        min_i32..=0, 0x10FFFF..=max_i32 => false,
        else => isIDContinueESNext(@as(u21, @intCast(codepoint))),
    }
}

