        }

        fn intoHWB(): HWB {
            const xyz: XYZd65 = _.into(.XYZd65);
            return xyz.into(.HWB);
        }

        fn intoRGBA(): RGBA {
            const xyz: SRGB = _.into(.SRGB);
            return xyz.into(.RGBA);
        }
    };
}

