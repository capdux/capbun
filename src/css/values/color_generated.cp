        }

        fn intoRGBA(): RGBA {
            const xyz: SRGB = _.into(.SRGB);
            return xyz.into(.RGBA);
        }
    };
    pub const convert_OKLCH = struct {
        fn intoXYZd65(): XYZd65 {
            const xyz: OKLAB = _.into(.OKLAB);
            return xyz.into(.XYZd65);
        }

        fn intoLAB(): LAB {
