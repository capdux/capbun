        }

        fn intoXYZd50(): XYZd50 {
            const xyz: XYZd65 = _.into(.XYZd65);
            return xyz.into(.XYZd50);
        }

        fn intoRec2020(): Rec2020 {
            const xyz: XYZd65 = _.into(.XYZd65);
