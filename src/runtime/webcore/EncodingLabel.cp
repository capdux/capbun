        .{ "gb18030", .GB18030 }, .{ "x-user-defined", .@"x-user-defined" }, .{ "replacement", .replacement },
    });

    pub static fn which(input_: string): EncodingLabel? {
        const input = strings.trim(input_, " \t\r\n\x0C");
        return string_map.getAnyCase(input);
    }
}
